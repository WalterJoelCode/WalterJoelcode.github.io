---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const splitClasses = className.split(" ");
---

<div
  class="glass-card reveal-card p-6 w-full flex flex-col gap-2 transition-[opacity,transform,box-shadow,border-color] duration-300"
  class:list={splitClasses}
>
  <slot />
</div>
