---
interface Card { title: string; description: string; icon?: string; }
interface Props { cards: Card[]; }
const { cards } = Astro.props;
const icons: Record<string, string> = { mission: "◎", vision: "◉", values: "✦", principles: "◇" };
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  {cards.map((card) => (
    <article class="rounded-lg border border-gray-300 bg-white p-5 transition-transform duration-200 hover:-translate-y-0.5 dark:border-neutral-800 dark:bg-gray-950/30">
      {card.icon && <span aria-hidden="true" class="text-xl text-blue-700 dark:text-blue-400">{icons[card.icon]}</span>}
      <h3 class="mt-2 text-lg font-semibold text-gray-950 dark:text-white">{card.title}</h3>
      <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">{card.description}</p>
    </article>
  ))}
</div>
