---
import Card from "../components/Card.astro";
import Layout from "../layouts/Layout.astro";
import TimelineItem from "../components/TimelineItem.astro";
import Project from "../components/Project.astro";
import EXPERIENCES from "../assets/collections/experiences.json";
import { PROJECTS } from "../data/projects/catalog";
import HireServiceModal from "../components/HireServiceModal.astro";

const base = import.meta.env.BASE_URL;
---

<Layout>
  <section id="home" class="flex flex-col">
    <article class="text-gray-950 dark:text-white text-pretty mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold max-w-screen-sm">
        Hola, soy Walter Joel Castil Corea
      </h1>
      <div class="flex flex-col gap-6 mt-4">
        <h2 class="font-bold text-xl sm:text-2xl">
          Ingeniero en Sistemas de Información
        </h2>
      </div>
    </article>
  </section>

  <section id="about" class="flex flex-col">
    <h2
      class="text-2xl md:text-4xl font-bold text-gray-950 dark:text-white mb-2"
    >
      Sobre mí
    </h2>
    <article class="flex flex-col gap-6 p-4">
      <Card className="text-gray-600 dark:text-gray-400">
        <div class="flex flex-col gap-2 text-sm sm:text-base">
          <h3 class="text-lg sm:text-xl font-semibold text-gray-950 dark:text-white">
            Perfil profesional 🧬
          </h3>

          <p>
            Soy Ingeniero en Sistemas de Información desarrollando habilidades y experiencias en diseño y construcción de aplicaciones web, automatización de procesos administrativos, diseño de interfaces, bases de datos relacionales y gestión de proyectos tecnológicos combinando soluciones modernas, eficientes y escalables en base a los requerimientos del negocio o cliente.
          </p>

          <p>
            Me apasiona combinar desarrollo, UX/UI y automatización para mejorar la operación y la experiencia de las personas usuarias, por eso mi formación profesional incluye el diseño gráfico.
          </p>
        </div>

        <div class="flex flex-col gap-2 mt-6 items-end text-right">
          <h3 class="text-lg sm:text-xl font-semibold text-gray-950 dark:text-white">
            ¿Quieres conocer más?
          </h3>

          <a
            href={`${base}docs/cv.pdf`}
            role="button"
            aria-label="Download CV"
            download
            class="px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-800 dark:bg-blue-700 focus:ring-4 focus:outline-hidden focus:ring-blue-200 dark:focus:ring-blue-950 text-white font-semibold transition-all duration-300"
          >
            Descargar CV
          </a>
        </div>
      </Card>
    <h2
      class="text-2xl md:text-4xl font-bold text-gray-950 dark:text-white mb-2"
    >
      Formación Profesional
    </h2>
      <Card className="p-8">
        <ol class="relative border-s border-gray-300 dark:border-neutral-800">
          {
            EXPERIENCES.map((experience) => (
              <TimelineItem
                title={experience.company}
                description={experience.description}
                date={experience.dates}
              >
                <div
                  slot="icon"
                  class="size-full p-1"
                  set:html={experience.svgIcon}
                />
              </TimelineItem>
            ))
          }
        </ol>
      </Card>
    </article>
  </section>

  <section id="projects" class="flex flex-col">
    <h2
      class="text-2xl md:text-4xl font-bold text-gray-950 dark:text-white mb-4"
    >
      Proyectos destacados
    </h2>
    <div class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        PROJECTS.filter((__, i) => i < 3).map((project) => (
          <Project project={project} />
        ))
      }
    </div>
    <div class="mt-6 flex justify-center">
      <a
        role="button"
        href={`${base}projects/`}
        class="font-semibold transition-colors px-4 py-2 text-base rounded-3xl bg-blue-600 hover:bg-transparent hover:border hover:border-blue-600 hover:text-blue-600 dark:bg-blue-800 text-white dark:hover:bg-transparent dark:hover:border-blue-800 dark:hover:text-blue-800 duration-300"
        >Ver todos los proyectos</a
      >
    </div>
  </section>

  <section id="technologies" class="flex flex-col overflow-hidden">
    <h2 class="text-2xl md:text-4xl font-bold text-gray-950 dark:text-white mb-6">
      Tecnologías
    </h2>

    <article class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 text-gray-600 dark:text-gray-400 p-2">
      {[
        'Laravel',
        'PHP',
        'Livewire',
        'MySQL',
        'Bootstrap',
        'Astro',
        'Git',
        'GitHub',
        'DomPDF',
        'Chart.js',
        'Font Awesome'
      ].map((technology) => (
        <Card className="py-2 px-3 text-center text-sm font-medium">
          {technology}
        </Card>
      ))}
    </article>
  </section>

  <section id="skills" class="flex flex-col overflow-hidden mt-10">
    <h2 class="text-2xl md:text-4xl font-bold text-gray-950 dark:text-white mb-6">
      Habilidades
    </h2>

    <article class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-2">
      {[
        'Desarrollo Web',
        'Diseño Gráfico',
        'Análisis de requerimientos',
        'UX/UI',
        'Bases de datos relacionales',
        'Gestión de proyectos',
        'Briefing & Branding',
        'Pedagogía informática'
      ].map((skill) => (
        <Card className="py-3 px-4">
          <p class="font-semibold text-gray-950 dark:text-white text-center">
            {skill}
          </p>
        </Card>
      ))}
    </article>
  </section>

  <section id="contact" class="flex flex-col gap-6">
    <h2 class="text-2xl md:text-4xl font-bold text-gray-950 dark:text-white">
      Contacto y redes sociales
    </h2>
      <Card className="p-6">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 text-gray-700 dark:text-gray-300">

          <li class="flex items-center gap-4">
            <svg class="size-5 shrink-0 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"/>
            </svg>

            <div>
              <p class="font-semibold text-gray-900 dark:text-white">Correo</p>
              <a
                href="mailto:waltercastil2019@outlook.com"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors break-all"
              >
                waltercastil2019@outlook.com
              </a>
            </div>
          </li>

          <li class="flex items-center gap-4">
            <svg class="size-5 shrink-0 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9.75 17L9 21h6l-.75-4M4 5h16v10a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"/>
            </svg>

            <div>
              <p class="font-semibold text-gray-900 dark:text-white">GitHub</p>
              <a
                href="https://github.com/WalterJoelCode"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                github.com/WalterJoelCode
              </a>
            </div>
          </li>

          <li class="flex items-center gap-4">
            <svg class="size-5 shrink-0 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 8a6 6 0 016 6v5h-4v-5a2 2 0 00-4 0v5h-4V9h4v2a4 4 0 013-1z"/>
              <rect x="2" y="9" width="4" height="10" rx="1"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>

            <div>
              <p class="font-semibold text-gray-900 dark:text-white">LinkedIn</p>
              <a
                href="https://www.linkedin.com/in/waltercorea/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                linkedin.com/in/waltercorea
              </a>
            </div>
          </li>

          <li class="flex items-center gap-4">
            <svg class="size-5 shrink-0 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 14l9-5-9-5-9 5 9 5zm0 0v6m-6-3v1c0 2 3 4 6 4s6-2 6-4v-1"/>
            </svg>

            <div>
              <p class="font-semibold text-gray-900 dark:text-white">ORCID</p>
              <a
                href="https://orcid.org/0009-0000-6492-9108"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                0009-0000-6492-9108
              </a>
            </div>
          </li>

        </ul>
      </Card>
  </section>
  <HireServiceModal />
</Layout>
