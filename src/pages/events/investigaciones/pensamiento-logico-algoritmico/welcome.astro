---
import logoport from "../../../../assets/logoport.svg";
const base = import.meta.env.BASE_URL;
const researchHref = `${base}events/investigaciones/pensamiento-logico-algoritmico/`;
const welcomeUrl = "https://walterjoelcode.github.io/events/investigaciones/pensamiento-logico-algoritmico/welcome/";
export const prerender = true;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={logoport.src} />
    <title>Pensamiento lógico y algorítmico</title>
  </head>
  <body>
    <main class="welcome">
      <div class="symbols" aria-hidden="true"><span>{ }</span><span>→</span><span>?</span><span>if</span><span>01</span><span>+</span><span>≠</span><span>;</span></div>
      <section class="content">
        <p class="category">Buenas prácticas educativas</p>
        <h1>Fortalecimiento del pensamiento lógico y algorítmico mediante el aprendizaje progresivo con pseudocódigo y PSeInt en protagonistas de la educación técnica</h1>
        <p class="intro">Descubre cómo el pseudocódigo y PSeInt fortalecen la resolución de problemas.</p>
        <div class="qr-action"><div class="qr-card"><div class="qr-code" data-qr-code data-qr-url={welcomeUrl} role="img" aria-label="Código QR para abrir la bienvenida de la investigación"></div><p>Escanea para abrir la bienvenida</p></div><a class="read-more" href={researchHref}>Leer más información <span aria-hidden="true">→</span></a></div>
      </section>
      <button class="theme-toggle" type="button" aria-label="Cambiar a modo claro" data-theme-toggle><svg data-sun-icon aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg><svg data-moon-icon class="hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6 8.5 8.5 0 1 0 20.4 15.4Z"/></svg></button>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }:global(html), :global(body) { min-height: 100%; margin: 0; }
  :global(body) { background: #09090b; color: #f8f8fa; font-family: "Segoe UI", system-ui, sans-serif; color-scheme: dark; }
  .welcome { position: relative; display: grid; min-height: 100svh; place-items: center; isolation: isolate; overflow: hidden; padding: 2rem; background: radial-gradient(circle at 50% 30%, #25101f 0, #110d13 58%, #09090b 100%); }
  .content { position: relative; z-index: 1; width: min(68rem, 100%); text-align: center; animation: enter .55s ease-out both; }.category { margin: 0 0 .8rem; color: #ff78bd; font-size: .76rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }h1 { margin: 0; color: #ffb0d8; font-size: clamp(1.8rem, 3.9vw, 3.25rem); line-height: 1.08; letter-spacing: -.04em; }.intro { margin: 1rem auto 1.5rem; max-width: 42rem; color: #d4bdc9; line-height: 1.6; }
  .qr-action { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }.qr-card { display: flex; flex-direction: column; align-items: center; gap: .65rem; border: 1px solid rgb(255 176 216 / .25); border-radius: 1rem; padding: .75rem; background: rgb(255 255 255 / .94); box-shadow: 0 1rem 2.5rem rgb(0 0 0 / .22); }.qr-code { display: grid; width: clamp(8.75rem, 25vw, 11.25rem); aspect-ratio: 1; place-items: center; }.qr-code :global(svg) { display: block; width: 100%; height: 100%; }.qr-card p { margin: 0; color: #4b3943; font-size: .78rem; font-weight: 600; }
  .read-more { display: inline-flex; align-items: center; gap: .6rem; border-radius: 999px; padding: .85rem 1.3rem; background: #d10072; color: #fff; font-size: .95rem; font-weight: 700; text-decoration: none; box-shadow: 0 .7rem 1.8rem rgb(209 0 114 / .3); transition: transform .2s ease, background-color .2s ease; }.read-more:hover { background: #ad005f; transform: translateY(-2px); }.read-more:focus-visible, .theme-toggle:focus-visible { outline: 2px solid #c4a4ff; outline-offset: 4px; }
  .symbols { position: absolute; inset: 0; z-index: -1; color: #ff78bd; font-family: ui-monospace, monospace; font-size: clamp(2.1rem, 7vw, 6rem); font-weight: 700; opacity: .12; pointer-events: none; }.symbols span { position: absolute; animation: float 5s ease-in-out infinite alternate; }.symbols span:nth-child(1) { top: 12%; left: 12%; }.symbols span:nth-child(2) { right: 13%; top: 24%; animation-delay: -2s; }.symbols span:nth-child(3) { right: 18%; bottom: 13%; animation-delay: -3s; }.symbols span:nth-child(4) { left: 8%; bottom: 17%; font-size: .62em; animation-delay: -1s; }.symbols span:nth-child(5) { top: 35%; left: 22%; font-size: .48em; animation-delay: -4s; }.symbols span:nth-child(6) { top: 8%; right: 29%; font-size: .72em; animation-delay: -2.5s; }.symbols span:nth-child(7) { right: 7%; bottom: 31%; font-size: .55em; animation-delay: -1.5s; }.symbols span:nth-child(8) { top: 65%; left: 29%; font-size: .5em; animation-delay: -3.5s; }
  .theme-toggle { position: fixed; right: max(1.5rem, env(safe-area-inset-right)); bottom: max(1.5rem, env(safe-area-inset-bottom)); z-index: 2; display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border: 1px solid rgb(255 176 216 / .45); border-radius: 999px; padding: .7rem; background: transparent; color: #ffb0d8; cursor: pointer; }.theme-toggle svg { width: 100%; height: 100%; }.theme-toggle .hidden { display: none; }
  @keyframes enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }@keyframes float { to { transform: translateY(-10px) rotate(4deg); } }
  :global(html[data-theme="light"]) body { background: #fff; color: #17171b; color-scheme: light; }:global(html[data-theme="light"]) .welcome { background: radial-gradient(circle at 50% 30%, #fff 0, #fdf8fc 64%, #f6edf4 100%); }:global(html[data-theme="light"]) .category { color: #a8005c; }:global(html[data-theme="light"]) h1 { color: #d10072; }:global(html[data-theme="light"]) .intro { color: #66555e; }:global(html[data-theme="light"]) .symbols { color: #d10072; }:global(html[data-theme="light"]) .theme-toggle { border-color: rgb(168 0 92 / .4); color: #a8005c; }
  :global(::view-transition-old(root)) { animation: none; }:global(::view-transition-new(root)) { animation: theme-wave .62s cubic-bezier(.22, 1, .36, 1); }@keyframes theme-wave { from { clip-path: circle(0 at calc(100% - 2.9rem) calc(100% - 2.9rem)); } to { clip-path: circle(150% at calc(100% - 2.9rem) calc(100% - 2.9rem)); } }
  @media (max-width: 560px) { .welcome { padding: 1.5rem; }.symbols span:nth-child(1) { left: 4%; }.symbols span:nth-child(2) { right: 5%; }.symbols span:nth-child(3) { right: 8%; } }@media (prefers-reduced-motion: reduce) { .content, .symbols span { animation: none; }.read-more { transition: none; } }
</style>

<script>
  import QRCode from "qrcode";

  const qrCode = document.querySelector<HTMLElement>("[data-qr-code]");
  const qrUrl = qrCode?.dataset.qrUrl;
  if (qrCode && qrUrl) {
    QRCode.toString(qrUrl, {
      type: "svg",
      errorCorrectionLevel: "M",
      margin: 1,
      color: { dark: "#17171b", light: "#ffffff" },
    }).then((svg) => {
      qrCode.innerHTML = svg;
    });
  }

  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const html = document.documentElement; const sun = document.querySelector("[data-sun-icon]"); const moon = document.querySelector("[data-moon-icon]");
  const applyTheme = (theme: "light" | "dark") => { html.dataset.theme = theme; localStorage.setItem("investigation-welcome-theme", theme); button?.setAttribute("aria-label", theme === "dark" ? "Cambiar a modo claro" : "Cambiar a modo oscuro"); sun?.classList.toggle("hidden", theme === "light"); moon?.classList.toggle("hidden", theme === "dark"); };
  const saved = localStorage.getItem("investigation-welcome-theme"); if (saved === "light" || saved === "dark") applyTheme(saved);
  button?.addEventListener("click", () => {
    const nextTheme = html.dataset.theme === "dark" ? "light" : "dark";
    if ("startViewTransition" in document) {
      (document as Document & { startViewTransition: (update: () => void) => void }).startViewTransition(() => applyTheme(nextTheme));
      return;
    }
    applyTheme(nextTheme);
  });
</script>
